    {
      "parameters": {
        "jsCode": "// @ts-ignore\nconst buffer = await this.helpers.getBinaryDataBuffer(0, 'data');\n\nconst documents = JSON.parse(buffer.toString('utf8'));\n\nif (!Array.isArray(documents)) {\n  throw new Error('documents.json must be an array.');\n}\n\nreturn documents.map((doc, index) => {\n  const requiredFields = ['document_id', 'title', 'category', 'file_name'];\n\n  for (const field of requiredFields) {\n    if (!doc[field]) {\n      throw new Error(`Missing field \"${field}\" in documents.json item ${index + 1}`);\n    }\n  }\n\n  return {\n    json: {\n      document_id: doc.document_id,\n      title: doc.title,\n      category: doc.category,\n      file_name: doc.file_name,\n      file_path: `/home/node/.n8n-files/data/mock-data/${doc.file_name}`\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        0
      ],
      "id": "b79b4a0a-571a-4d7a-88c4-ff454efcbc2b",
      "name": "Create File List"
    },
    {
      "parameters": {
        "fileSelector": "={{ $json.file_path }}",
        "options": {}
      },
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1.1,
      "position": [
        624,
        0
      ],
      "id": "f97d17e4-63b4-47fb-9a91-e8174583a709",
      "name": "Read Files from Disk"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst fileListItems = $('Create File List').all();\nconst output = [];\n\nfunction cleanText(text) {\n  return String(text || '')\n    .replace(/\\r\\n/g, '\\n')\n    .replace(/\\n{3,}/g, '\\n\\n')\n    .trim();\n}\n\nfor (let itemIndex = 0; itemIndex < items.length; itemIndex++) {\n  const metadata = fileListItems[itemIndex].json;\n\n  // @ts-ignore\n  const buffer = await this.helpers.getBinaryDataBuffer(itemIndex, 'data');\n  const fileContent = cleanText(buffer.toString('utf8'));\n\n  const lines = fileContent.split('\\n');\n\n  let currentSectionTitle = 'Genel';\n  let currentLines = [];\n  let chunkIndex = 1;\n\n  function pushSection() {\n    const content = cleanText(currentLines.join('\\n'));\n\n    if (!content) return;\n\n    output.push({\n      json: {\n        text: content,\n        metadata: {\n          document_id: metadata.document_id,\n          title: metadata.title,\n          category: metadata.category,\n          section_title: currentSectionTitle,\n          chunk_index: chunkIndex,\n          file_name: metadata.file_name\n        }\n      }\n    });\n\n    chunkIndex++;\n  }\n\n  for (const line of lines) {\n    const sectionMatch = line.match(/^##\\s+(.+)$/);\n\n    if (sectionMatch) {\n      pushSection();\n      currentSectionTitle = sectionMatch[1].trim();\n      currentLines = [line];\n    } else {\n      currentLines.push(line);\n    }\n  }\n\n  pushSection();\n}\n\nreturn output;"
      },
