      "name": "Webhook",
      "webhookId": "62bd7712-3b07-4c2e-b9eb-e40f92e911b5"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const body = $json.body || {};\n\nconst question = String(body.question || '').trim();\nconst answer = String(body.answer || '').trim();\nconst feedback = String(body.feedback || '').trim();\nconst sources = Array.isArray(body.sources) ? body.sources : [];\n\nif (!question) {\n  throw new Error('Question is required.');\n}\n\nif (!answer) {\n  throw new Error('Answer is required.');\n}\n\nif (!['useful', 'not_useful'].includes(feedback)) {\n  throw new Error('Feedback must be either \"useful\" or \"not_useful\".');\n}\n\nreturn {\n  json: {\n    question,\n    answer,\n    feedback,\n    sources\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        208,
        0
      ],
      "id": "5aa8d2a4-693c-4493-91a4-bac9ab84da18",
      "name": "Validate Feedback"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const question = $json.question;\nconst answer = $json.answer;\nconst feedback = $json.feedback;\nconst sources = $json.sources || [];\n\nfunction sqlEscape(value) {\n  return String(value ?? '').replace(/'/g, \"''\");\n}\n\nconst sourcesJson = JSON.stringify(sources);\n\nconst insertQuery = `\nWITH inserted AS (\n  INSERT INTO feedback_logs (\n    question,\n    answer,\n    feedback,\n    sources\n  )\n  VALUES (\n    '${sqlEscape(question)}',\n    '${sqlEscape(answer)}',\n    '${sqlEscape(feedback)}',\n    '${sqlEscape(sourcesJson)}'::jsonb\n  )\n  RETURNING id, created_at\n)\nSELECT id, created_at\nFROM inserted;\n`;\n\nreturn {\n  json: {\n    question,\n    answer,\n    feedback,\n    sources,\n    insert_query: insertQuery\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        0
      ],
      "id": "f81fe8fd-93c3-4080-81de-7647d03f1762",
      "name": "Prepare Feedback Insert"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "{{ $json.insert_query }}",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        624,
        0
      ],
      "id": "b385b648-d44f-44cd-857b-83a97c6b8807",
      "name": "Insert Feedback",
      "credentials": {
        "postgres": {
          "id": "jShdzm8IEPIqSd41",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const feedbackData = $('Validate Feedback').first().json;\n\nreturn {\n  json: {\n    status: 'success',\n    message: 'Feedback saved successfully.',\n    feedback: feedbackData.feedback\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
