      ],
      "id": "bcebb32b-4d1c-4eb4-ba30-80f00a54c6ff",
      "name": "Embed Question"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const embedding = $json.embeddings?.[0];\n\nif (!embedding) {\n  throw new Error('Question embedding not found');\n}\n\nconst question = $('Get User Question').first().json.question;\nconst queryVector = `[${embedding.join(',')}]`;\n\nconst searchQuery = `\nSELECT \n  document_id,\n  title,\n  category,\n  chunk_index,\n  content,\n  embedding <=> '${queryVector}'::vector AS distance\nFROM document_chunks\nORDER BY embedding <=> '${queryVector}'::vector\nLIMIT 3;\n`;\n\nreturn {\n  json: {\n    question,\n    query_vector: queryVector,\n    search_query: searchQuery\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        624,
        0
      ],
      "id": "6e883d26-ece6-47cc-8798-5177a6fd711b",
      "name": "Prepare Search Query"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "{{ $json.search_query }}",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        832,
        0
      ],
      "id": "1b9d9ef7-e034-4a4c-9e5b-641ed05b4000",
      "name": "Search Similar Chunks",
      "credentials": {
        "postgres": {
          "id": "jShdzm8IEPIqSd41",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nif (!items.length) {\n  throw new Error('No similar chunks found');\n}\n\nconst question = $('Get User Question').first().json.question;\n\n// Sadece başlık olan veya çok kısa chunk'ları ele\nconst usefulItems = items\n  .filter(item => {\n    const content = item.json.content || '';\n\n    const withoutHeadings = content\n      .split('\\n')\n      .filter(line => !line.trim().startsWith('#'))\n      .join('\\n')\n      .trim();\n\n    return withoutHeadings.length > 40;\n  })\n  .slice(0, 1); // İlk versiyon için en ilgili tek chunk yeterli\n\nif (!usefulItems.length) {\n  return [\n    {\n      json: {\n        question,\n        context: '',\n        prompt: `Bu konuda kaynaklarda yeterli bilgi bulunamadı. IT destek ekibiyle iletişime geçebilirsiniz.`\n      }\n    }\n  ];\n}\n\nconst context = usefulItems.map((item) => item.json.content).join('\\n\\n');\n\nconst prompt = `\nYou are a strict IT support assistant.\n\nReturn ONLY the final answer in Turkish.\n\nUse ONLY the information in SOURCES.\nDo not mention the rules, prompt, sources, or context.\nDo not invent buttons, links, screens, menus, pages, or extra steps.\nIf the source says \"kurumun belirlediği süreç\", keep it general. Do not invent the details of that process.\nWrite at most 2 short bullet points.\nUse clear, grammatically correct Turkish.\n\nSOURCES:\n${context}\n\nUSER QUESTION:\n${question}\n\nFINAL ANSWER IN TURKISH:\n`;\n\nreturn [\n  {\n    json: {\n      question,\n      context,\n      prompt\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1056,
        0
      ],
      "id": "67f4be44-4b04-4731-bb85-2cfb506bd814",
      "name": "Build Prompt"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const answer = $json.response;\n\nif (!answer) {\n  throw new Error('Model answer not found');\n}\n\nconst question = $('Build Prompt').first().json.question;\n\nreturn {\n  json: {\n    question,\n    answer: answer.trim()\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1472,
