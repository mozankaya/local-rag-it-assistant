      "webhookId": "758f71a8-65e3-4bd9-a630-0cf0d1b21798"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const body = $json.body || {};\nconst question = body.question || body.query || body.message;\n\nif (!question || String(question).trim().length === 0) {\n  throw new Error('Question is required. Send JSON body like: { \"question\": \"...\" }');\n}\n\nreturn {\n  json: {\n    question: String(question).trim()\n  }\n};"
      },
